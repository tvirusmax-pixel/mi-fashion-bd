<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MI Fashion BD</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#fffafd;color:#493744}
header{
background:linear-gradient(120deg,#f8dce8,#dceeff);
padding:30px 15px;text-align:center;
}
header h1{color:#984b70;margin:0;font-size:32px}
header p{margin:8px}
nav{text-align:center;padding:15px;background:white}
nav a{margin:10px;color:#984b70;text-decoration:none;font-weight:bold}
.hero{text-align:center;padding:45px 15px;background:#f2f8ff}
.hero h2{font-size:30px}
button{
background:#a94f70;color:white;border:0;
padding:12px 20px;border-radius:25px;
cursor:pointer;font-weight:bold
}
.container{max-width:1100px;margin:auto;padding:20px}
.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:18px
}
.card{
background:white;border:1px solid #f0dce6;
border-radius:16px;padding:15px;
box-shadow:0 3px 12px #ddd
}
.card img{width:100%;height:180px;object-fit:cover;border-radius:12px}
.price{color:#a94f70;font-weight:bold}
select,input{padding:10px;width:100%;margin:7px 0;border:1px solid #ddd;border-radius:8px}
footer{
text-align:center;padding:25px;
background:linear-gradient(120deg,#f8dce8,#dceeff)
}
</style>
</head>
<body>
<header>
<h1>MI FASHION BD</h1>
<p>Lovely Essentials For Your Little One ♡</p>
</header>
<nav>
<a href="#home">Home</a>
<a href="#products">Products</a>
<a href="#contact">Contact</a>
</nav>
<section class="hero" id="home">
<h2>Welcome to MI Fashion BD</h2>
<p>Beautiful Baby Products With Love</p>
<a href="#products"><button>Shop Now</button></a>
</section>
<section class="container" id="products">
<h2 style="text-align:center;color:#984b70">
Our Baby Collection ♡
</h2>

<div class="grid" id="productList">

<div class="card">
<img src="https://placehold.co/400x300/f8dce8/984b70?text=Baby+Bedding" alt="Baby Bedding">
<h3>Baby Bedding Combo</h3>
<p>Beautiful and comfortable baby bedding set.</p>
<p class="price">৳999</p>
<label>Choose Colour</label>
<select id="colour1">
<option>Pink</option>
<option>Baby Blue</option>
<option>Cream</option>
</select>
<button onclick="orderProduct('Baby Bedding Combo','999','colour1')">
Order Now
</button>
</div>

<div class="card">
<img src="https://placehold.co/400x300/dceeff/526d91?text=Baby+Pillow" alt="Baby Pillow">
<h3>Baby Pillow Set</h3>
<p>Soft velvet baby pillow set.</p>
<p class="price">Contact for price</p>
<label>Choose Colour</label>
<select id="colour2">
<option>Pink</option>
<option>Blue</option>
<option>Mustard</option>
</select>
<button onclick="orderProduct('Baby Pillow Set','Contact for price','colour2')">
Order Now
</button>
</div>

<div class="card">
<img src="https://placehold.co/400x300/f8dce8/984b70?text=Cape+Towel" alt="Cape Towel">
<h3>Baby Cape Towel</h3>
<p>Super soft baby bath towel.</p>
<p class="price">Contact for price</p>
<label>Choose Colour</label>
<select id="colour3">
<option>Pink</option>
<option>Blue</option>
<option>White</option>
</select>
<button onclick="orderProduct('Baby Cape Towel','Contact for price','colour3')">
Order Now
</button>
</div>

</div>
</section>
<section class="container" id="contact">
<h2 style="text-align:center;color:#984b70">
Place Your Order ♡
</h2>

<p style="text-align:center">
Order directly through WhatsApp. Cash on Delivery available across Bangladesh.
</p>

<div style="max-width:450px;margin:auto">
<label>Your Name</label>
<input type="text" id="customerName" placeholder="Enter your name">

<label>Your Mobile Number</label>
<input type="tel" id="customerPhone" placeholder="01XXXXXXXXX">

<label>Your Full Address</label>
<input type="text" id="customerAddress" placeholder="Enter your address">

<button onclick="sendOrder()" style="width:100%">
Send Order on WhatsApp
</button>
</div>
</section>

<footer>
<h3>MI FASHION BD ♡</h3>
<p>Baby Products | Baby Bedding | Baby Care</p>
<p>WhatsApp: 01983746716</p>
<p>Cash on Delivery Available</p>
<p>© 2026 MI Fashion BD. All Rights Reserved.</p>
</footer>

<script>
const whatsappNumber = "8801983746716";

function orderProduct(name, price, colourId) {
 const colour = document.getElementById(colourId).value;
 const message =
 `Assalamu Alaikum! I want to order:
Product: ${name}
Price: ${price}
Colour: ${colour}`;
 window.open(
 "https://wa.me/" + whatsappNumber +
 "?text=" + encodeURIComponent(message),
 "_blank"
 );
}

function sendOrder() {
 const name = document.getElementById("customerName").value.trim();
 const phone = document.getElementById("customerPhone").value.trim();
 const address = document.getElementById("customerAddress").value.trim();

 if (!name || !phone || !address) {
  alert("Please fill in all information.");
  return;
 }

 const message =
 `New Order - MI Fashion BD
Customer Name: ${name}
Phone: ${phone}
Address: ${address}`;

 window.open(
 "https://wa.me/" + whatsappNumber +
 "?text=" + encodeURIComponent(message),
 "_blank"
 );
}
</script>

</body>
</html>